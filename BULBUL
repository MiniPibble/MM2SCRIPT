-- =============================================
--   HELPER: TOGGLE ROW
--   Entire row is a TextButton for easy clicking
-- =============================================

local function MakeToggle(labelText, subText, defaultOn, order, callback)
    -- Invisible full-row button catches all clicks
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 52)
    btn.BackgroundColor3 = Color3.fromRGB(12, 12, 24)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.Parent = Content
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(50, 50, 90)
    stroke.Thickness = 0.8
    stroke.Parent = btn

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -58, 0, 20)
    nameLabel.Position = UDim2.new(0, 10, 0, 8)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = labelText
    nameLabel.TextColor3 = Color3.fromRGB(225, 225, 245)
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = btn

    local subLabel = Instance.new("TextLabel")
    subLabel.Size = UDim2.new(1, -58, 0, 14)
    subLabel.Position = UDim2.new(0, 10, 0, 30)
    subLabel.BackgroundTransparency = 1
    subLabel.Text = subText
    subLabel.TextColor3 = Color3.fromRGB(85, 85, 125)
    subLabel.TextSize = 9
    subLabel.Font = Enum.Font.Gotham
    subLabel.TextXAlignment = Enum.TextXAlignment.Left
    subLabel.Parent = btn

    -- Track (background pill)
    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 44, 0, 24)
    track.Position = UDim2.new(1, -54, 0.5, -12)
    track.BackgroundColor3 = defaultOn and Color3.fromRGB(34, 197, 94) or Color3.fromRGB(55, 55, 90)
    track.BorderSizePixel = 0
    track.Parent = btn
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    -- Thumb (white circle)
    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 18, 0, 18)
    thumb.Position = defaultOn and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local isOn = defaultOn
    local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad)

    local function setToggle(state)
        isOn = state
        if isOn then
            TweenService:Create(track, tweenInfo, {BackgroundColor3 = Color3.fromRGB(34, 197, 94)}):Play()
            TweenService:Create(thumb, tweenInfo, {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
        else
            TweenService:Create(track, tweenInfo, {BackgroundColor3 = Color3.fromRGB(55, 55, 90)}):Play()
            TweenService:Create(thumb, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
        end
        callback(isOn)
    end

    btn.MouseButton1Click:Connect(function()
        setToggle(not isOn)
    end)

    return btn
end

