-- =============================================
--   RUNTIME LOOP
-- =============================================

RunService.Heartbeat:Connect(function()
    -- Status label update
    local parts = {}
    if Settings.FreezeTrade then table.insert(parts, "Freeze") end
    if Settings.AutoAccept then table.insert(parts, "AutoAccept") end
    if Settings.ForceGiveHighValue then table.insert(parts, "ForceHV") end
    if #parts > 0 then
        StatusLabel.Text = "Active: " .. table.concat(parts, " | ")
        StatusLabel.TextColor3 = Color3.fromRGB(34, 197, 94)
    else
        StatusLabel.Text = "Status: All Off"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 70, 70)
    end

    -- Freeze Trade
    if Settings.FreezeTrade then
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui")
        if tradeGui then
            for _, btn in ipairs(tradeGui:GetDescendants()) do
                if btn:IsA("TextButton") and (
                    string.lower(btn.Name):find("accept") or
                    string.lower(tostring(btn.Text)):find("accept")
                ) then
                    btn.Active = false
                    btn.AutoButtonColor = false
                end
            end
        end
    end

    -- Auto Accept
    if Settings.AutoAccept then
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui")
        if tradeGui then
            for _, btn in ipairs(tradeGui:GetDescendants()) do
                if btn:IsA("TextButton") and btn.Visible and (
                    string.lower(btn.Name):find("accept") or
                    string.lower(tostring(btn.Text)):find("accept")
                ) then
                    pcall(function() btn:Activate() end)
                end
            end
        end
    end

    -- Force Give High Value
    if Settings.ForceGiveHighValue and Settings.TargetUsername ~= "" then
        pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("TradeEvent")
                or ReplicatedStorage:FindFirstChild("Trade")
                or ReplicatedStorage:FindFirstChild("TradeRequest")
            if remote then
                remote:FireServer("ForceHighValue", Settings.TargetUsername)
            end
        end)
    end
end)

